[run]
# Coverage data is recorded in one CI job (run_python_tests.yml) and
# combined/reported in a completely different one (sonar_scan.yml's own
# "Combine coverage data" step) -- without this, coverage.py stores
# ABSOLUTE file paths at collection time, and `coverage xml`'s emitted
# <class filename="..."> entries end up rooted however that path happened
# to resolve, which SonarQube's Python coverage sensor can silently fail
# to match back to sonar.sources=Source (no error, just 0% coverage --
# exactly what the SonarQube Cloud dashboard was showing project-wide,
# across both languages, despite the report existing and being handed to
# the scanner). Relative paths, always rooted at the repo root both jobs
# checkout to, removes the ambiguity entirely.
relative_files = True
source = Source
# Test code isn't production code -- measuring it inflates the total.
omit =
    Source/tests/*

[report]
# Also applied at report time, so data recorded before [run]'s omit (or by
# an older checkout) still reports production code only.
omit =
    Source/tests/*
# Script-launch lines only run when a file is executed directly, and
# patch_sklearn() only where the optional sklearnex package is installed.
exclude_also =
    if __name__ == .__main__.:
    patch_sklearn\(\)
