# Applies to every sport's Docker build in this repo -- context root is
# Source/ for all of them, so this file is shared rather than duplicated
# per sport.

**/__pycache__/
**/*.pyc
**/*.pyo
**/*.egg-info/
**/.pytest_cache/
**/.venv/
**/build/
**/dist/

# Test source isn't needed in any runtime image
tests/

# Other sports/components -- irrelevant per-image, keeps context upload small
front-end/

# ingest/normalize Lambdas (any sport) are zip-packaged, never built via
# Docker (see python_lambda_build.yml) -- excluded individually, not via
# a blanket `aws-lambdas/` exclusion, since Docker can't reliably
# re-include a nested path (e.g. predict/, which IS a Docker build -- see
# Source/aws-lambdas/nfl/predict/Dockerfile) once a parent directory is
# excluded.
aws-lambdas/*/ingest/
aws-lambdas/*/normalize/
