<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/acc_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="NFL · WIN PROBABILITY"
        android:textAllCaps="true"
        android:textColor="@color/widget_ink_sub"
        android:textSize="10sp"
        android:letterSpacing="0.06"/>

    <TextView
        android:id="@+id/acc_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/widget_choose_sport"
        android:textColor="@color/widget_ink_sub"
        android:textSize="12sp"
        android:visibility="gone"/>

    <LinearLayout
        android:id="@+id/acc_body"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="2dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="5"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/acc_big"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="68%"
                    android:textColor="@color/widget_ink"
                    android:textSize="30sp"
                    android:textStyle="bold"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/acc_season"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:text="of 77 games"
                        android:textColor="@color/widget_ink_sub"
                        android:textSize="11sp"/>

                    <TextView
                        android:id="@+id/acc_last"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:text="Wk 5: 75%"
                        android:textColor="@color/widget_ink"
                        android:textSize="12sp"/>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:letterSpacing="0.09"
                android:maxLines="1"
                android:text="@string/widget_average_miss"
                android:textAllCaps="true"
                android:textColor="@color/widget_ink_sub"
                android:textSize="9sp"
                android:textStyle="bold"/>

            <LinearLayout
                android:id="@+id/acc_miss1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/acc_miss1_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Score Margin"
                    android:textColor="@color/widget_ink"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/acc_miss1_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:text="±10.2 pts"
                    android:textColor="@color/widget_cyan"
                    android:textSize="12sp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/acc_miss2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/acc_miss2_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Home Score"
                    android:textColor="@color/widget_ink"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/acc_miss2_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:text="±7.4 pts"
                    android:textColor="@color/widget_cyan"
                    android:textSize="12sp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/acc_miss3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/acc_miss3_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Away Score"
                    android:textColor="@color/widget_ink"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/acc_miss3_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:text="±7.1 pts"
                    android:textColor="@color/widget_cyan"
                    android:textSize="12sp"/>
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:background="@color/widget_border"/>

        <LinearLayout
            android:id="@+id/acc_bands"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="4"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:letterSpacing="0.09"
                android:maxLines="1"
                android:text="@string/widget_by_confidence"
                android:textAllCaps="true"
                android:textColor="@color/widget_ink_sub"
                android:textSize="9sp"
                android:textStyle="bold"/>

            <LinearLayout
                android:id="@+id/acc_band1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/acc_band1_tag"
                    android:layout_width="34dp"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:maxLines="1"
                    android:text="HIGH"
                    android:textColor="@color/widget_ink_sub"
                    android:textSize="9sp"/>

                <ProgressBar
                    android:id="@+id/acc_band1_bar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="81"
                    android:progressDrawable="@drawable/widget_pick_bar"/>

                <TextView
                    android:id="@+id/acc_band1_pct"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:text="81%"
                    android:textColor="@color/widget_cyan"
                    android:textSize="11sp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/acc_band2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/acc_band2_tag"
                    android:layout_width="34dp"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:maxLines="1"
                    android:text="MED"
                    android:textColor="@color/widget_ink_sub"
                    android:textSize="9sp"/>

                <ProgressBar
                    android:id="@+id/acc_band2_bar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="66"
                    android:progressDrawable="@drawable/widget_pick_bar"/>

                <TextView
                    android:id="@+id/acc_band2_pct"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:text="66%"
                    android:textColor="@color/widget_cyan"
                    android:textSize="11sp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/acc_band3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/acc_band3_tag"
                    android:layout_width="34dp"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:maxLines="1"
                    android:text="LOW"
                    android:textColor="@color/widget_ink_sub"
                    android:textSize="9sp"/>

                <ProgressBar
                    android:id="@+id/acc_band3_bar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="54"
                    android:progressDrawable="@drawable/widget_pick_bar"/>

                <TextView
                    android:id="@+id/acc_band3_pct"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:text="54%"
                    android:textColor="@color/widget_cyan"
                    android:textSize="11sp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
