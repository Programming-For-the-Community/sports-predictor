<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/acc_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="NFL · WIN PROBABILITY"
        android:textAllCaps="true"
        android:textColor="@color/widget_ink_sub"
        android:textSize="@dimen/widget_text_caption"
        android:letterSpacing="0.06"/>

    <TextView
        android:id="@+id/acc_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/widget_choose_sport"
        android:textColor="@color/widget_ink_sub"
        android:textSize="@dimen/widget_text_body"
        android:visibility="gone"/>

    <LinearLayout
        android:id="@+id/acc_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/acc_big"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="68%"
                android:textColor="@color/widget_ink"
                android:textSize="@dimen/widget_text_figure"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/acc_season"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="right this season · 77"
                android:textColor="@color/widget_ink_sub"
                android:textSize="@dimen/widget_text_meta"/>

            <TextView
                android:id="@+id/acc_last"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                android:text="Wk 5: 75%"
                android:textColor="@color/widget_ink"
                android:textSize="@dimen/widget_text_body"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/acc_bands"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/widget_border"/>

            <TextView
                android:id="@+id/acc_bands_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:letterSpacing="0.09"
                android:maxLines="1"
                android:text="@string/widget_by_confidence"
                android:textAllCaps="true"
                android:textColor="@color/widget_ink_sub"
                android:textSize="@dimen/widget_text_tag"
                android:textStyle="bold"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/acc_band1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="0dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/acc_band1_tag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.08"
                        android:maxLines="1"
                        android:text="HIGH"
                        android:textColor="@color/widget_ink_sub"
                        android:textSize="@dimen/widget_text_tag"/>

                    <TextView
                        android:id="@+id/acc_band1_pct"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:maxLines="1"
                        android:text="81%"
                        android:textColor="@color/widget_ink"
                        android:textSize="@dimen/widget_text_row"/>

                    <ProgressBar
                        android:id="@+id/acc_band1_bar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:layout_marginTop="2dp"
                        android:max="100"
                        android:progress="81"
                        android:progressDrawable="@drawable/widget_pick_bar"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/acc_band2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/acc_band2_tag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.08"
                        android:maxLines="1"
                        android:text="MED"
                        android:textColor="@color/widget_ink_sub"
                        android:textSize="@dimen/widget_text_tag"/>

                    <TextView
                        android:id="@+id/acc_band2_pct"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:maxLines="1"
                        android:text="66%"
                        android:textColor="@color/widget_ink"
                        android:textSize="@dimen/widget_text_row"/>

                    <ProgressBar
                        android:id="@+id/acc_band2_bar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:layout_marginTop="2dp"
                        android:max="100"
                        android:progress="66"
                        android:progressDrawable="@drawable/widget_pick_bar"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/acc_band3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/acc_band3_tag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.08"
                        android:maxLines="1"
                        android:text="LOW"
                        android:textColor="@color/widget_ink_sub"
                        android:textSize="@dimen/widget_text_tag"/>

                    <TextView
                        android:id="@+id/acc_band3_pct"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:maxLines="1"
                        android:text="54%"
                        android:textColor="@color/widget_ink"
                        android:textSize="@dimen/widget_text_row"/>

                    <ProgressBar
                        android:id="@+id/acc_band3_bar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:layout_marginTop="2dp"
                        android:max="100"
                        android:progress="54"
                        android:progressDrawable="@drawable/widget_pick_bar"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
