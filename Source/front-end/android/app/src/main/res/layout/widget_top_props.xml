<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/picks_sport"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="Top player props · NFL"
            android:textColor="@color/widget_ink"
            android:textSize="12sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/picks_heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:maxWidth="140dp"
            android:text="Today"
            android:textColor="@color/widget_ink_sub"
            android:textSize="11sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/prop1_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/prop1_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="P. Mahomes · KC"
            android:textColor="@color/widget_ink"
            android:textSize="13sp"/>

        <TextView
            android:id="@+id/prop1_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:text="284 pass yds ±38"
            android:textColor="@color/widget_cyan"
            android:textSize="12sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/prop2_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/prop2_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="J. Allen · BUF"
            android:textColor="@color/widget_ink"
            android:textSize="13sp"/>

        <TextView
            android:id="@+id/prop2_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:text="262 pass yds ±41"
            android:textColor="@color/widget_cyan"
            android:textSize="12sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/prop3_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/prop3_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="S. Barkley · PHI"
            android:textColor="@color/widget_ink"
            android:textSize="13sp"/>

        <TextView
            android:id="@+id/prop3_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:text="104 rush yds ±19"
            android:textColor="@color/widget_cyan"
            android:textSize="12sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/prop4_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/prop4_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="J. Gibbs · DET"
            android:textColor="@color/widget_ink"
            android:textSize="13sp"/>

        <TextView
            android:id="@+id/prop4_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:text="91 rush yds ±18"
            android:textColor="@color/widget_cyan"
            android:textSize="12sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/prop5_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/prop5_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="J. Jefferson · MIN"
            android:textColor="@color/widget_ink"
            android:textSize="13sp"/>

        <TextView
            android:id="@+id/prop5_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:text="98 rec yds ±22"
            android:textColor="@color/widget_cyan"
            android:textSize="12sp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/picks_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/widget_choose_sport"
        android:textColor="@color/widget_ink_sub"
        android:textSize="12sp"
        android:visibility="gone"/>
</LinearLayout>
