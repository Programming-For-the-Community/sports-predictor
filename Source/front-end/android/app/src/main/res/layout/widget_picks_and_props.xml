<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/picks_sport"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="Today's top picks · NFL"
            android:textColor="@color/widget_ink"
            android:textSize="12sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/picks_heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:maxWidth="140dp"
            android:text="Today"
            android:textColor="@color/widget_ink_sub"
            android:textSize="11sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/pick1_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/pick1_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="KC @ JAX"
                android:textColor="@color/widget_ink"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/pick1_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:text="KC 68%"
                android:textColor="@color/widget_cyan"
                android:textSize="12sp"/>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/pick1_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="3dp"
            android:max="100"
            android:progress="68"
            android:progressDrawable="@drawable/widget_pick_bar"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/pick2_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/pick2_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="DET @ MIN"
                android:textColor="@color/widget_ink"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/pick2_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:text="DET 61%"
                android:textColor="@color/widget_cyan"
                android:textSize="12sp"/>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/pick2_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="3dp"
            android:max="100"
            android:progress="61"
            android:progressDrawable="@drawable/widget_pick_bar"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/pick3_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/pick3_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="SF @ LAR"
                android:textColor="@color/widget_ink"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/pick3_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:text="LAR 53%"
                android:textColor="@color/widget_cyan"
                android:textSize="12sp"/>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/pick3_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="3dp"
            android:max="100"
            android:progress="53"
            android:progressDrawable="@drawable/widget_pick_bar"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/props_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="9dp"
            android:background="@color/widget_border"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:letterSpacing="0.09"
            android:maxLines="1"
            android:text="@string/widget_props_label"
            android:textAllCaps="true"
            android:textColor="@color/widget_ink_sub"
            android:textSize="10sp"
            android:textStyle="bold"/>

        <LinearLayout
            android:id="@+id/prop1_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/prop1_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="P. Mahomes · KC"
                android:textColor="@color/widget_ink"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/prop1_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:text="284 pass yds ±38"
                android:textColor="@color/widget_cyan"
                android:textSize="12sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/prop2_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/prop2_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="J. Allen · BUF"
                android:textColor="@color/widget_ink"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/prop2_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:text="262 pass yds ±41"
                android:textColor="@color/widget_cyan"
                android:textSize="12sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/prop3_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/prop3_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="S. Barkley · PHI"
                android:textColor="@color/widget_ink"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/prop3_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:text="104 rush yds ±19"
                android:textColor="@color/widget_cyan"
                android:textSize="12sp"/>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/picks_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/widget_choose_sport"
        android:textColor="@color/widget_ink_sub"
        android:textSize="12sp"
        android:visibility="gone"/>
</LinearLayout>
