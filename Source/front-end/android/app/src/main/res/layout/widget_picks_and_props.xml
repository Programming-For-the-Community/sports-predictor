            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Today's top picks · NFL"
            android:textColor="@color/widget_ink"
            android:textSize="@dimen/widget_text_body"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/picks_heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:maxWidth="140dp"
            android:text="Today"
            android:textColor="@color/widget_ink_sub"
            android:textSize="@dimen/widget_text_meta"/>
    </LinearLayout>

    <TextView
        android:id="@+id/picks_message"
