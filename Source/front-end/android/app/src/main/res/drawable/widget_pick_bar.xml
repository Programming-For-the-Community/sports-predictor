<?xml version="1.0" encoding="utf-8"?>
<!-- Picked side's chance in cyan over the other side's in muted red. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape><corners android:radius="2dp"/><solid android:color="@color/widget_track"/></shape>
    </item>
    <item android:id="@android:id/progress">
        <clip><shape><corners android:radius="2dp"/><solid android:color="@color/widget_cyan"/></shape></clip>
    </item>
</layer-list>
