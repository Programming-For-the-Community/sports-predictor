%%{init: {'flowchart': {'curve': 'stepAfter', 'nodeSpacing': 45, 'rankSpacing': 65}}}%%
%% sports-predictor -- scheduled data pipeline, registry-driven and shared
%% across every onboarded sport (NFL, NCAA FB, NBA, NCAA MBB, PGA Tour, F1
%% -- all 6 flow through both orchestrators identically, so per-sport
%% Lambdas/tasks are drawn once per TYPE with a "x6" annotation rather
%% than 36 near-identical nodes). Companion diagrams:
%% design/AWS_ARCHITECTURE.mmd (client request path),
%% design/AWS_ARCHITECTURE_OBSERVABILITY.mmd (dashboards/alarms/tracing).
%% See docs/AWS_ARCHITECTURE.md for the full walkthrough and legend -- this
%% file is the single source of truth for this diagram; the doc links here
%% and embeds a generated image rather than duplicating this source
%% (regenerate the image after editing this file -- see the doc's own
%% comment for the exact command).
%% Solid arrows = data flow / invocation. Dotted arrows = supporting,
%% non-data-flow dependency (container image pull, registry read, scale-
%% down/reap action).
flowchart TD
    SCHIN["EventBridge Scheduler<br/>ingest-orchestrator (daily)"]
    SCHTRAIN["EventBridge Scheduler<br/>training-orchestrator (monthly)"]
    SCHSYNC["EventBridge Scheduler<br/>{sport}-schedule-sync  x6<br/>(refreshes the full-season calendar,<br/>not just the current week)"]
    SCHREAP["EventBridge Scheduler<br/>ec2-training-reaper (10 min)"]
    REG[("DynamoDB: Sport Registry<br/>season window, training_targets")]

    subgraph SFNBox["Step Functions -- registry-driven fan-out (shared, every sport)"]
        direction LR
        SFNINGEST["State Machine:<br/>ingest-orchestrator<br/>(Map over registry sports)"]
        SFNTRAIN["State Machine:<br/>training-orchestrator<br/>(Map per sport, then<br/>Distributed Map per<br/>training_target -- X-Ray traced)"]
        SEASONGATE["Lambda: season-gate<br/>(season_start/season_end check,<br/>shared by both state machines --<br/>X-Ray traced)"]
    end

    INGEST["Lambda: {sport}-ingest  x6<br/>(invoked by name convention,<br/>&lt;project&gt;-&lt;sport&gt;-ingest)"]
    NORMALIZE["Lambda: {sport}-normalize  x6"]
    SRC(["Free sports data APIs<br/>ESPN / CFBD / Jolpica-F1 / etc."])
    ECR[("ECR<br/>shared, pre-existing")]

    subgraph PubSub["VPC public subnets (3 AZs) + Internet Gateway"]
        direction LR
        BACKFILL["Fargate: {sport}-backfill  x6<br/>(manual run-task, historical only)"]
        FEAT["Fargate: {sport}-feature-engineering  x6<br/>(on-demand, unchanged)"]
    end

    subgraph EC2Box["EC2 training fleet -- Spot-primary, on-demand fallback<br/>(sole training compute path; Fargate training retired)"]
        direction LR
        ASGSPOT["ASG: ec2-training-spot"]
        ASGOND["ASG: ec2-training-ondemand"]
        TRAIN["ECS tasks (EC2 launch type):<br/>train-win-probability / train-score /<br/>train-player-prop / train-ranking /<br/>sport-specific targets -- x6 sports,<br/>~35 targets total"]
    end
    REAPER["Lambda: ec2-training-reaper<br/>(idle-instance backstop --<br/>X-Ray traced)"]

    subgraph StorageBox["Storage, partitioned by sport key"]
        direction LR
        S3RAW[("S3: Raw Data Lake")]
        S3MODEL[("S3: Model Artifacts")]
        DDBCORE[("DynamoDB: entities / events /<br/>player_game_stats / team_game_stats")]
    end

    %% ---- Scheduled ingestion, registry-driven ----
    SCHIN -->|"triggers"| SFNINGEST
    SFNINGEST -.->|"scan"| REG
    SFNINGEST -->|"per sport: season check"| SEASONGATE
    SFNINGEST -->|"if in season: invoke by name"| INGEST
    INGEST -->|"fetch scoreboard/box scores"| SRC
    INGEST -->|"write raw JSON"| S3RAW
    S3RAW -->|"ObjectCreated, per-sport prefix"| NORMALIZE
    NORMALIZE -->|"upsert"| DDBCORE

    %% ---- Full-season schedule refresh, independent of daily ingest ----
    SCHSYNC -->|"invokes directly"| INGEST
    INGEST -->|"writes full-season scoreboard"| S3RAW

    %% ---- One-time historical backfill (unchanged, still manual) ----
    BACKFILL -->|"fetch full history"| SRC
    BACKFILL -->|"write raw JSON"| S3RAW
    BACKFILL -->|"upsert"| DDBCORE
    BACKFILL -.->|"pulls image"| ECR

    %% ---- Scheduled training, registry-driven ----
    SCHTRAIN -->|"triggers"| SFNTRAIN
    SFNTRAIN -.->|"scan"| REG
    SFNTRAIN -->|"per sport: season check"| SEASONGATE
    SFNTRAIN -->|"if in season: run task"| FEAT
    FEAT -->|"read history"| DDBCORE
    FEAT -->|"write Parquet"| S3MODEL
    SFNTRAIN -->|"then fan out over training_targets<br/>via capacity providers"| ASGSPOT
    SFNTRAIN -.->|"fallback when Spot unavailable"| ASGOND
    ASGSPOT --> TRAIN
    ASGOND --> TRAIN
    TRAIN -->|"read Parquet, write model +<br/>model_card per candidate,<br/>promote whichever wins"| S3MODEL
    SFNTRAIN -.->|"explicit scale-to-0 once<br/>ForEachSport completes"| ASGSPOT
    SFNTRAIN -.->|"explicit scale-to-0"| ASGOND
    SCHREAP -->|"triggers"| REAPER
    REAPER -.->|"terminates idle instances<br/>(independent backstop --<br/>catches a manually-stopped run)"| ASGSPOT
    REAPER -.->|"terminates idle instances"| ASGOND
    FEAT -.->|"pulls image"| ECR

    classDef pipelineCompute fill:#fff3bf,stroke:#e8b800,color:#5c4a00;
    classDef fargateCompute fill:#b2f2bb,stroke:#2f9e44,color:#0b3d1c;
    classDef ec2Compute fill:#ffe066,stroke:#f08c00,color:#5c3d00;
    classDef storage fill:#ffc9c9,stroke:#e03131,color:#5c1111;
    classDef schedule fill:#e9ecef,stroke:#495057,color:#212529,stroke-dasharray: 4 3;
    classDef external fill:#dee2e6,stroke:#343a40,color:#212529;
    classDef orchestration fill:#e0e7ff,stroke:#4338ca,color:#1e1650;

    class SRC,ECR external;
    class INGEST,NORMALIZE pipelineCompute;
    class BACKFILL,FEAT fargateCompute;
    class ASGSPOT,ASGOND,TRAIN,REAPER ec2Compute;
    class S3RAW,S3MODEL,DDBCORE,REG storage;
    class SCHIN,SCHTRAIN,SCHSYNC,SCHREAP schedule;
    class SFNINGEST,SFNTRAIN,SEASONGATE orchestration;

    style PubSub fill:#e6fcf5,stroke:#2f9e44
    style EC2Box fill:#fff9db,stroke:#f08c00
    style StorageBox fill:#fff5f5,stroke:#e03131
    style SFNBox fill:#f5f3ff,stroke:#4338ca
