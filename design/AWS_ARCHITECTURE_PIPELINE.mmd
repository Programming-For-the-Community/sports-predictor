%%{init: {'flowchart': {'curve': 'stepAfter', 'nodeSpacing': 45, 'rankSpacing': 65}}}%%
%% sports-predictor -- scheduled data pipeline (NFL, Phase 1 adapter shown;
%% ingest/training ORCHESTRATION itself is shared/registry-driven across
%% every onboarded sport as of Phase 4, pulled forward ahead of Phase 2/3 --
%% see design/PROJECT_PLAN.md's Phase 4 section and sfn-ingest-orchestrator.tf
%% / sfn-training-orchestrator.tf). Companion diagram
%% design/AWS_ARCHITECTURE.mmd covers the client request path. See
%% docs/AWS_ARCHITECTURE.md for the full walkthrough and legend -- this
%% file is the single source of truth for this diagram; the doc links here
%% and embeds a generated image rather than duplicating this source
%% (regenerate the image after editing this file -- see the doc's own
%% comment for the exact command).
%% Solid arrows = data flow / invocation. Dotted arrows = supporting,
%% non-data-flow dependency (container image pull, registry read).
flowchart TD
    SCHIN["EventBridge Scheduler<br/>ingest-orchestrator (daily, year-round)"]
    SCHTRAIN["EventBridge Scheduler<br/>training-orchestrator (monthly)"]
    REG[("DynamoDB: Sport Registry<br/>season window, training_targets")]

    subgraph SFNBox["Step Functions -- registry-driven fan-out (shared, every sport)"]
        direction LR
        SFNINGEST["State Machine:<br/>ingest-orchestrator<br/>(Map over registry sports)"]
        SFNTRAIN["State Machine:<br/>training-orchestrator<br/>(Map per sport, then<br/>Distributed Map per<br/>training_target)"]
        SEASONGATE["Lambda: season-gate<br/>(season_start/season_end check,<br/>shared by both state machines)"]
    end

    INGEST["Lambda: nfl-ingest<br/>(invoked by name convention,<br/>&lt;project&gt;-&lt;sport&gt;-ingest)"]
    NORMALIZE["Lambda: nfl-normalize"]
    ESPN(["ESPN Public API<br/>(unofficial)"])
    ECR[("ECR<br/>shared, pre-existing")]

    subgraph PubSub["VPC public subnets (3 AZs) + Internet Gateway"]
        direction LR
        BACKFILL["Fargate: nfl-backfill<br/>(manual run-task, historical only)"]
        FEAT["Fargate: nfl-feature-engineering"]
        TRAIN["Fargate: train-win-probability-model /<br/>train-score-model /<br/>train-player-prop-model /<br/>train-ranking-model"]
    end

    subgraph StorageBox["Storage"]
        direction LR
        S3RAW[("S3: Raw Data Lake")]
        S3MODEL[("S3: Model Artifacts")]
        DDBCORE[("DynamoDB: entities / events /<br/>player_game_stats / team_game_stats")]
    end

    %% ---- Scheduled ingestion, registry-driven ----
    SCHIN -->|"triggers"| SFNINGEST
    SFNINGEST -.->|"scan"| REG
    SFNINGEST -->|"per sport: season check"| SEASONGATE
    SFNINGEST -->|"if in season: invoke by name"| INGEST
    INGEST -->|"fetch scoreboard"| ESPN
    INGEST -->|"write raw JSON"| S3RAW
    S3RAW -->|"ObjectCreated"| NORMALIZE
    NORMALIZE -->|"upsert"| DDBCORE

    %% ---- One-time historical backfill (unchanged, still manual) ----
    BACKFILL -->|"fetch full history"| ESPN
    BACKFILL -->|"write raw JSON"| S3RAW
    BACKFILL -->|"upsert"| DDBCORE
    BACKFILL -.->|"pulls image"| ECR

    %% ---- Scheduled training, registry-driven ----
    SCHTRAIN -->|"triggers"| SFNTRAIN
    SFNTRAIN -.->|"scan"| REG
    SFNTRAIN -->|"per sport: season check"| SEASONGATE
    SFNTRAIN -->|"if in season: run task"| FEAT
    FEAT -->|"read history"| DDBCORE
    FEAT -->|"write Parquet"| S3MODEL
    SFNTRAIN -->|"then fan out over training_targets<br/>(vCPU-budget-capped concurrency)"| TRAIN
    TRAIN -->|"read Parquet, write model +<br/>model_card per candidate,<br/>promote whichever wins"| S3MODEL
    FEAT -.->|"pulls image"| ECR
    TRAIN -.->|"pulls image"| ECR

    classDef pipelineCompute fill:#fff3bf,stroke:#e8b800,color:#5c4a00;
    classDef fargateCompute fill:#b2f2bb,stroke:#2f9e44,color:#0b3d1c;
    classDef storage fill:#ffc9c9,stroke:#e03131,color:#5c1111;
    classDef schedule fill:#e9ecef,stroke:#495057,color:#212529,stroke-dasharray: 4 3;
    classDef external fill:#dee2e6,stroke:#343a40,color:#212529;
    classDef orchestration fill:#e0e7ff,stroke:#4338ca,color:#1e1650;

    class ESPN,ECR external;
    class INGEST,NORMALIZE pipelineCompute;
    class BACKFILL,FEAT,TRAIN fargateCompute;
    class S3RAW,S3MODEL,DDBCORE,REG storage;
    class SCHIN,SCHTRAIN schedule;
    class SFNINGEST,SFNTRAIN,SEASONGATE orchestration;

    style PubSub fill:#e6fcf5,stroke:#2f9e44
    style StorageBox fill:#fff5f5,stroke:#e03131
    style SFNBox fill:#f5f3ff,stroke:#4338ca
