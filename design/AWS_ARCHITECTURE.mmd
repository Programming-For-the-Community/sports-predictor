%%{init: {'flowchart': {'curve': 'stepAfter', 'nodeSpacing': 45, 'rankSpacing': 65}}}%%
%% sports-predictor -- client request path (NFL, Phase 1). Companion
%% diagram design/AWS_ARCHITECTURE_PIPELINE.mmd covers scheduled
%% ingestion/backfill/training. See docs/AWS_ARCHITECTURE.md for the full
%% walkthrough and legend -- this file is the single source of truth for
%% this diagram; the doc links here and embeds a generated image rather
%% than duplicating this source (regenerate the image after editing this
%% file -- see the doc's own comment for the exact command).
%% Solid arrows = data flow / invocation. Dotted arrows = supporting,
%% non-data-flow dependency (TLS cert, container image pull, VPC endpoint
%% path). Arrows are numbered 1-7 in request order.
flowchart TD
    BROWSER(["Browser<br/>Cognito-authenticated user"])
    R53["Route 53<br/>hosted zone"]
    ACM["ACM Certificate<br/>(us-east-1, DNS-validated)"]
    CF["CloudFront Distribution<br/>single public domain"]
    S3FE[("S3: Frontend")]
    APIGW["API Gateway REST API<br/>/nfl/* -- Cognito authorizer"]
    COGNITO["Cognito User Pool<br/>+ App Client"]

    subgraph VPCBox["VPC private subnets (3 AZs) -- no NAT Gateway"]
        direction LR
        PREDICTREAD["Lambda: nfl-predict-read<br/>(zip, read-only --<br/>no xgboost/scikit-learn/pandas)"]
        PREDICT["Lambda: nfl-predict<br/>(container image --<br/>xgboost/scikit-learn/pandas)"]
    end
    GWEP{{"VPC Gateway Endpoints<br/>S3 + DynamoDB"}}
    ECR[("ECR<br/>shared, pre-existing")]

    subgraph StorageBox["Storage"]
        direction LR
        S3MODEL[("S3: Model Artifacts")]
        DDBCORE[("DynamoDB: entities / events /<br/>player_game_stats / team_game_stats")]
        DDBPRED[("DynamoDB: predictions")]
    end

    BROWSER -->|"1. HTTPS"| CF
    R53 -.->|"alias"| CF
    ACM -.->|"TLS cert"| CF
    CF -->|"2a. /*"| S3FE
    CF -->|"2b. /nfl/*"| APIGW
    APIGW -->|"3. validates JWT"| COGNITO
    APIGW -->|"4a. /events, /models"| PREDICTREAD
    APIGW -->|"4b. /season, /predictions/*"| PREDICT
    VPCBox -.->|"outbound HTTPS"| GWEP
    GWEP -.-> StorageBox
    PREDICTREAD -->|"5a. read events + logged predictions"| DDBCORE
    PREDICTREAD -->|"5b. read model card metadata"| S3MODEL
    PREDICTREAD -.->|"read predictions"| DDBPRED
    PREDICT -->|"5. read live features"| DDBCORE
    PREDICT -->|"6. read + deserialize model"| S3MODEL
    PREDICT -->|"7. write audit record"| DDBPRED
    PREDICT -.->|"pulls image"| ECR

    classDef client fill:#e8eaed,stroke:#5f6368,color:#202124;
    classDef edge fill:#cfe8fc,stroke:#1a73e8,color:#0b3d78;
    classDef auth fill:#e6d9f7,stroke:#7b3fe4,color:#3a1a63;
    classDef servingCompute fill:#ffd8a8,stroke:#e8590c,color:#5c2200;
    classDef storage fill:#ffc9c9,stroke:#e03131,color:#5c1111;
    classDef external fill:#dee2e6,stroke:#343a40,color:#212529;

    class BROWSER client;
    class ECR,GWEP external;
    class R53,ACM,CF,S3FE edge;
    class APIGW,COGNITO auth;
    class PREDICT,PREDICTREAD servingCompute;
    class S3MODEL,DDBCORE,DDBPRED storage;

    style VPCBox fill:#fff3bf,stroke:#e8b800
    style StorageBox fill:#fff5f5,stroke:#e03131
