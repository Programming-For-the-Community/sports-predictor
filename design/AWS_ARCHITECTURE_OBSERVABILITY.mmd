%%{init: {'flowchart': {'curve': 'stepAfter', 'nodeSpacing': 45, 'rankSpacing': 65}}}%%
%% sports-predictor -- observability and cost-guardrail layer, cutting
%% across both the client request path (design/AWS_ARCHITECTURE.mmd) and
%% the scheduled pipeline (design/AWS_ARCHITECTURE_PIPELINE.mmd). This is
%% intentionally a separate diagram, not overlaid on either -- it isn't a
%% data-flow hop those diagrams' numbered request/pipeline order should
%% include, it's a cross-cutting concern most every compute/storage node
%% on both feeds into. See docs/AWS_ARCHITECTURE.md for the walkthrough.
%% Solid arrows = metrics/logs/traces flowing in. Dotted arrows = alarm
%% notification.
flowchart TD
    subgraph Sources["Every compute + storage resource on both other diagrams"]
        direction LR
        LAMBDAS["Every Lambda  x30+<br/>(ingest/normalize/predict/<br/>predict-read/live-scores/<br/>schedule-sync/season-gate/<br/>ec2-training-reaper x6 sports + shared)"]
        ECSTASKS["ECS tasks<br/>(feature-engineering, training)"]
        APIGWSRC["API Gateway"]
        CFSRC["CloudFront"]
        DDBSRC["DynamoDB tables  x6"]
        SFNSRC["Step Functions<br/>(both orchestrators)"]
    end

    XRAY["X-Ray<br/>Active tracing: training-orchestrator<br/>state machine + season-gate +<br/>ec2-training-reaper Lambdas"]
    APPMAP["CloudWatch Application Map<br/>(Service Map, built from X-Ray traces)"]

    subgraph Dashboards["CloudWatch Dashboards  x7"]
        direction LR
        DASHALERT["Alert-state<br/>(all 25 alarms at a glance)"]
        DASHAPI["API Gateway<br/>volume/errors/latency"]
        DASHDDB["DynamoDB<br/>capacity/throttling, x6 tables"]
        DASHECS["ECS/Fargate<br/>cluster + per-task-family utilization"]
        DASHLAMBDA["Lambda observability<br/>invocations/errors/duration/<br/>concurrency/throttles"]
        DASHSFN["Step Functions<br/>execution outcomes/duration"]
        DASHVIEWER["Viewer analytics<br/>Logs Insights: location/browser/<br/>device/endpoint"]
    end

    ALARMS["25 CloudWatch Alarms<br/>(18 logical concerns): Lambda errors/<br/>throttles/duration, DynamoDB throttles,<br/>orchestrator failed/timed-out,<br/>API Gateway 4xx/5xx/latency,<br/>CloudFront 5xx"]
    SNS["SNS Topic: ops-alerts"]
    EMAIL(["Email<br/>Critical-tier alarms only --<br/>Warning-tier shows on the<br/>dashboard, no notification"])
    BUDGET["AWS Budgets<br/>project total + per-sport,<br/>80%/100% actual, 100% forecast"]
    COSTEMAIL(["Email<br/>budget threshold breach"])

    LAMBDAS -->|"traces"| XRAY
    SFNSRC -->|"traces"| XRAY
    XRAY --> APPMAP

    LAMBDAS --> DASHLAMBDA
    LAMBDAS --> DASHVIEWER
    ECSTASKS --> DASHECS
    APIGWSRC --> DASHAPI
    CFSRC -.->|"5xx rate feeds"| ALARMS
    DDBSRC --> DASHDDB
    SFNSRC --> DASHSFN
    ALARMS --> DASHALERT

    LAMBDAS -.->|"error/throttle/duration metrics"| ALARMS
    DDBSRC -.->|"throttle/system-error metrics"| ALARMS
    SFNSRC -.->|"failed/timed-out metrics"| ALARMS
    APIGWSRC -.->|"4xx/5xx/latency metrics"| ALARMS
    ALARMS -.->|"Critical-tier only"| SNS
    SNS -.-> EMAIL

    BUDGET -.->|"threshold breach"| COSTEMAIL

    classDef tracing fill:#e0e7ff,stroke:#4338ca,color:#1e1650;
    classDef dashboard fill:#cfe8fc,stroke:#1a73e8,color:#0b3d78;
    classDef alerting fill:#ffc9c9,stroke:#e03131,color:#5c1111;
    classDef cost fill:#d3f9d8,stroke:#2f9e44,color:#0b3d1c;
    classDef source fill:#e9ecef,stroke:#495057,color:#212529;
    classDef external fill:#dee2e6,stroke:#343a40,color:#212529;

    class LAMBDAS,ECSTASKS,APIGWSRC,CFSRC,DDBSRC,SFNSRC source;
    class XRAY,APPMAP tracing;
    class DASHALERT,DASHAPI,DASHDDB,DASHECS,DASHLAMBDA,DASHSFN,DASHVIEWER dashboard;
    class ALARMS,SNS alerting;
    class BUDGET cost;
    class EMAIL,COSTEMAIL external;

    style Sources fill:#f8f9fa,stroke:#868e96
    style Dashboards fill:#f1f8ff,stroke:#1a73e8
